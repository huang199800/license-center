# Compose reads .env. CLI reads process environment only (no implicit dotenv loading).
LC_DOMAIN=licenses.example.com
LC_DATA=data
LC_HOST=127.0.0.1
LC_PORT=8000
# Business example configuration:
LICENSE_URL=https://licenses.example.com
LICENSE_PRODUCT=demo
LICENSE_TRUST_FILE=trusted-public-keys.json
LICENSE_CACHE=business-state/license.json
LICENSE_DEV_HTTP=0
# Do not put admin passwords, TOTP seeds or backup passphrases in this example.
